<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow Layer (Full size underneath, offset slightly down/right) -->
    <item
        android:top="2dp"
        android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#33000000" /> <!-- Darker alpha (20%) so it is visible -->
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Main White Card Layer (Shifted to reveal bottom-right shadow) -->
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</layer-list>