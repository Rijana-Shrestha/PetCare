<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:rotation="180"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_routine"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/ivBack"
            app:layout_constraintBottom_toBottomOf="@id/ivBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSaveTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="Save"
            android:textColor="@color/color_primary"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@id/ivBack"
            app:layout_constraintBottom_toBottomOf="@id/ivBack"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvAddFor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:text="@string/add_routine_for"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/ivBack"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/petCheckboxContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/card_white_rounded"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvAddFor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvRoutineDetailsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:text="@string/routine_details"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/petCheckboxContainer"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etTaskName"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/outlined_border"
            android:hint="@string/task_name"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvRoutineDetailsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etTaskType"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/outlined_border"
            android:hint="@string/task_type"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:layout_constraintTop_toBottomOf="@id/etTaskName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvScheduleLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:drawableStart="@drawable/ic_nav_schedule"
            android:drawablePadding="8dp"
            android:drawableTint="@color/color_primary"
            android:text="@string/schedule"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etTaskType"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etTime"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/outlined_border"
            android:hint="@string/time"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="false"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_clock"
            android:drawableTint="@color/color_black"
            android:drawablePadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvScheduleLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etDuration"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/outlined_border"
            android:hint="@string/duration_minutes"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="number"
            app:layout_constraintTop_toBottomOf="@id/etTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <AutoCompleteTextView
            android:id="@+id/actvRepeat"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/outlined_border"
            android:hint="@string/repeat"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="none"
            app:layout_constraintTop_toBottomOf="@id/etDuration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleCustomDays"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/actvRepeat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMon" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="M" android:textAllCaps="false" android:textSize="11sp"
                app:strokeColor="@color/color_primary" app:cornerRadius="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTue" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="T" android:textAllCaps="false" android:textSize="11sp"
                app:strokeColor="@color/color_primary" app:cornerRadius="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWed" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="W" android:textAllCaps="false" android:textSize="11sp"
                app:strokeColor="@color/color_primary" app:cornerRadius="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThu" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="T" android:textAllCaps="false" android:textSize="11sp"
                app:strokeColor="@color/color_primary" app:cornerRadius="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFri" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="F" android:textAllCaps="false" android:textSize="11sp"
                app:strokeColor="@color/color_primary" app:cornerRadius="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSat" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="S" android:textAllCaps="false" android:textSize="11sp"
                app:strokeColor="@color/color_primary" app:cornerRadius="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSun" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="S" android:textAllCaps="false" android:textSize="11sp"
                app:strokeColor="@color/color_primary" app:cornerRadius="0dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <EditText
            android:id="@+id/etStartDate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/outlined_border"
            android:hint="@string/start_date"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="false"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_nav_schedule"
            android:drawablePadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/toggleCustomDays"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvRemindersLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:drawableStart="@drawable/ic_clock"
            android:drawablePadding="8dp"
            android:text="@string/reminders"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etStartDate"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardReminder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/card_white_rounded"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvRemindersLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvReminderLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/reminder"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/switchReminder" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvRemindMeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/remind_me"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toBottomOf="@id/tvReminderLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/actvRemindOffset" />

            <AutoCompleteTextView
                android:id="@+id/actvRemindOffset"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:background="@drawable/outlined_border"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textSize="12sp"
                android:inputType="none"
                app:layout_constraintTop_toTopOf="@id/tvRemindMeLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvRemindMeLabel"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddRoutineSave"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:text="@string/add_routine"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/color_secondary"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardReminder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>