<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/ivPetPhoto"
            android:layout_width="0dp"
            android:layout_height="260dp"
            android:scaleType="centerCrop"
            android:background="@color/color_border_light"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:padding="6dp"
            android:background="@drawable/circle_avatar_placeholder"
            android:rotation="180"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/ivDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:background="@drawable/circle_avatar_placeholder"
            android:src="@drawable/ic_delete"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/ivEdit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:padding="8dp"
            android:background="@drawable/circle_avatar_placeholder"
            android:src="@drawable/ic_edit"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@id/ivDelete"
            app:layout_constraintBottom_toBottomOf="@id/ivDelete"
            app:layout_constraintEnd_toStartOf="@id/ivDelete" />

        <TextView
            android:id="@+id/tvPetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            tools:text="Max"
            app:layout_constraintTop_toBottomOf="@id/ivPetPhoto"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvPetBreedAge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="20dp"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            tools:text="Golden Retriever · 3 yrs"
            app:layout_constraintTop_toBottomOf="@id/tvPetName"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvWeightChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_white_rounded"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            tools:text="Wt: 25 kg"
            app:layout_constraintTop_toBottomOf="@id/tvPetBreedAge"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvGenderChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/card_white_rounded"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            tools:text="Male"
            app:layout_constraintTop_toTopOf="@id/tvWeightChip"
            app:layout_constraintBottom_toBottomOf="@id/tvWeightChip"
            app:layout_constraintStart_toEndOf="@id/tvWeightChip" />

        <TextView
            android:id="@+id/tvAboutLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:text="About"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintTop_toBottomOf="@id/tvWeightChip"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardAbout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/card_white_rounded"
            android:padding="18dp"
            app:layout_constraintTop_toBottomOf="@id/tvAboutLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvBirthdayLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/birthday"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvBirthdayValue" />

            <TextView
                android:id="@+id/tvBirthdayValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="end"
                tools:text="09 Dec 2022"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvBirthdayLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvDietLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/diet"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tvBirthdayLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvDietValue" />

            <TextView
                android:id="@+id/tvDietValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="end"
                tools:text="Chicken, Rice, Vegetables"
                app:layout_constraintTop_toTopOf="@id/tvDietLabel"
                app:layout_constraintStart_toEndOf="@id/tvDietLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvAllergiesLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/allergies"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tvDietLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvAllergiesValue" />

            <TextView
                android:id="@+id/tvAllergiesValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="end"
                tools:text="No known allergies"
                app:layout_constraintTop_toTopOf="@id/tvAllergiesLabel"
                app:layout_constraintStart_toEndOf="@id/tvAllergiesLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvFavToyLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/favorite_toy"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tvAllergiesLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvFavToyValue" />

            <TextView
                android:id="@+id/tvFavToyValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="end"
                tools:text="Blue Ball"
                app:layout_constraintTop_toTopOf="@id/tvFavToyLabel"
                app:layout_constraintStart_toEndOf="@id/tvFavToyLabel"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>