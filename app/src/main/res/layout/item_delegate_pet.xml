<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_stroke_unselected"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivPetAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/circle_avatar_placeholder"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPetName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        tools:text="Max"
        app:layout_constraintTop_toTopOf="@id/ivPetAvatar"
        app:layout_constraintBottom_toBottomOf="@id/ivPetAvatar"
        app:layout_constraintStart_toEndOf="@id/ivPetAvatar"
        app:layout_constraintEnd_toStartOf="@id/cbPetSelected" />

    <CheckBox
        android:id="@+id/cbPetSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        app:buttonTint="@color/color_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>