<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_white_rounded"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvCategoryIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_category_circle"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        tools:text="F"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvExpenseCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        tools:text="Food"
        app:layout_constraintTop_toTopOf="@id/tvCategoryIcon"
        app:layout_constraintStart_toEndOf="@id/tvCategoryIcon"
        app:layout_constraintEnd_toStartOf="@id/tvExpenseAmount" />

    <TextView
        android:id="@+id/tvExpensePetDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        tools:text="Max · Sep 4"
        app:layout_constraintTop_toBottomOf="@id/tvExpenseCategory"
        app:layout_constraintStart_toEndOf="@id/tvCategoryIcon"
        app:layout_constraintEnd_toStartOf="@id/tvExpenseAmount" />

    <TextView
        android:id="@+id/tvExpenseAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        tools:text="$32.00"
        app:layout_constraintTop_toTopOf="@id/tvCategoryIcon"
        app:layout_constraintBottom_toBottomOf="@id/tvCategoryIcon"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>