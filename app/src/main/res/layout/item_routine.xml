<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/color_border">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- Category badge: colored circle with a single-letter icon -->
        <TextView
            android:id="@+id/tvTypeIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_category_circle"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/color_white"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="F"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvRoutineTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Max · Morning Walk"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvTypeIcon"
            app:layout_constraintEnd_toStartOf="@id/tvRoutineTime" />

        <TextView
            android:id="@+id/tvRoutineSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="15 minutes"
            app:layout_constraintTop_toBottomOf="@id/tvRoutineTitle"
            app:layout_constraintStart_toEndOf="@id/tvTypeIcon"
            app:layout_constraintEnd_toStartOf="@id/tvRoutineTime" />

        <TextView
            android:id="@+id/tvRoutineTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            tools:text="Today 8:00 AM"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <CheckBox
            android:id="@+id/cbDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:useMaterialThemeColors="false"
            android:buttonTint="@color/color_secondary"
            app:layout_constraintTop_toBottomOf="@id/tvRoutineTime"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>