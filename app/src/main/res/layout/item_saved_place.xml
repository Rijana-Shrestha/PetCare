<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_white_rounded"
    android:elevation="2dp"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivPlaceIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:background="@drawable/ic_map_pin"
        android:backgroundTint="@color/color_primary"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPlaceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        tools:text="Happy Paws Veterinary Clinic"
        app:layout_constraintTop_toTopOf="@id/ivPlaceIcon"
        app:layout_constraintStart_toEndOf="@id/ivPlaceIcon"
        app:layout_constraintEnd_toStartOf="@id/ivDelete" />

    <TextView
        android:id="@+id/tvPlaceType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="@color/color_primary"
        tools:text="Vet Clinic"
        app:layout_constraintTop_toBottomOf="@id/tvPlaceName"
        app:layout_constraintStart_toEndOf="@id/ivPlaceIcon"
        app:layout_constraintEnd_toStartOf="@id/ivDelete" />

    <TextView
        android:id="@+id/tvPlaceAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        tools:text="Pulchowk, Lalitpur"
        app:layout_constraintTop_toBottomOf="@id/tvPlaceType"
        app:layout_constraintStart_toEndOf="@id/ivPlaceIcon"
        app:layout_constraintEnd_toStartOf="@id/ivDelete" />

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_delete"
        android:contentDescription="@null"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>