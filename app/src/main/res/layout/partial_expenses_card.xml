<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_white_rounded"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvExpensesLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/expenses"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnViewAllExpenses" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewAllExpenses"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:text="@string/view_all"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:textColor="@color/text_primary"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/color_primary"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/dividerExpenses"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/color_border_light"
        app:layout_constraintTop_toBottomOf="@id/tvExpensesLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shown when there ARE expenses -->
    <LinearLayout
        android:id="@+id/hasExpensesGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dividerExpenses"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This month"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvMonthlyTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            tools:text="$186.40" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentExpenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_expense" />

    </LinearLayout>

    <!-- Shown when there are NO expenses -->
    <TextView
        android:id="@+id/tvNoExpenses"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/no_expenses_yet"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/dividerExpenses"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Automatically sits below whichever of the two groups above is visible -
         no Kotlin needed for this part, unlike "what comes after this whole
         card," which each hosting screen (Profile, Home) positions itself. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierExpensesContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvNoExpenses,hasExpensesGroup" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddExpenses"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="@string/add_expenses"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/color_secondary"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/barrierExpensesContent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>