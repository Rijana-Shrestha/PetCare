<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.rijana.petcare.ui.auth.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_getStarted"
            app:destination="@id/getStartedFragment" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/getStartedFragment"
        android:name="com.rijana.petcare.ui.auth.GetStartedFragment"
        android:label="Get Started">
        <action
            android:id="@+id/action_getStarted_to_onboarding1"
            app:destination="@id/onboardingFragment1" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment1"
        android:name="com.rijana.petcare.ui.auth.OnboardingFragment1"
        android:label="Onboarding 1">
        <action
            android:id="@+id/action_onboarding1_to_onboarding2"
            app:destination="@id/onboardingFragment2" />
        <action
            android:id="@+id/action_onboarding1_to_signUp"
            app:destination="@id/signUpFragment" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment2"
        android:name="com.rijana.petcare.ui.auth.OnboardingFragment2"
        android:label="Onboarding 2">
        <action
            android:id="@+id/action_onboarding2_to_onboarding3"
            app:destination="@id/onboardingFragment3" />
        <action
            android:id="@+id/action_onboarding2_to_signUp"
            app:destination="@id/signUpFragment" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment3"
        android:name="com.rijana.petcare.ui.auth.OnboardingFragment3"
        android:label="Onboarding 3">
        <action
            android:id="@+id/action_onboarding3_to_signUp"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_onboarding3_to_signIn"
            app:destination="@id/signInFragment" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.rijana.petcare.ui.auth.SignUpFragment"
        android:label="Sign Up">
        <action
            android:id="@+id/action_signUp_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.rijana.petcare.ui.auth.SignInFragment"
        android:label="Sign In">
        <action
            android:id="@+id/action_signIn_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.rijana.petcare.ui.home.HomeFragment"
        android:label="Home" />

</navigation>